DB_URL=jdbc:postgresql://localhost:5432/ue_backend
DB_USER=ue_backend
DB_PASSWORD=ue_backend
REDIS_HOST=localhost
REDIS_PORT=6379
APP_CACHE_ENABLED=true
APP_CACHE_CATALOG_SNAPSHOT_TTL=PT10M
APP_CACHE_ACCESS_TTL=PT5M
JWT_SECRET=change-me-in-local-only

# Dedicated Server private mTLS connector.
# Public API remains on server.port=8080. /server/* must use SERVER_MTLS_PORT when enabled.
SERVER_MTLS_ENABLED=false
SERVER_MTLS_PORT=9443
SERVER_MTLS_REQUIRE_PRIVATE_PORT=true
SERVER_MTLS_ALLOW_HEADER_FINGERPRINT_FALLBACK=true
SERVER_MTLS_KEY_STORE=file:tools/mtls/out/backend.p12
SERVER_MTLS_KEY_STORE_PASSWORD=changeit
SERVER_MTLS_KEY_STORE_TYPE=PKCS12
SERVER_MTLS_KEY_ALIAS=backend
SERVER_MTLS_TRUST_STORE=file:tools/mtls/out/backend-truststore.p12
SERVER_MTLS_TRUST_STORE_PASSWORD=changeit
SERVER_MTLS_TRUST_STORE_TYPE=PKCS12
SERVER_MTLS_SSL_PROTOCOL=TLS
SERVER_MTLS_ENABLED_PROTOCOLS=TLSv1.3,TLSv1.2
