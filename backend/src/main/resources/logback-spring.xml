<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="backend-for-ue"/>

  <appender name="CONSOLE_TEXT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>{"timestamp":"%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX}","level":"%level","service":"${appName}","thread":"%thread","logger":"%logger","message":"%replace(%replace(%msg){'\\','\\\\'}){'"','\\"'}","exception":"%replace(%replace(%ex{short}){'\\','\\\\'}){'"','\\"'}"}%n</pattern>
    </encoder>
  </appender>

  <springProfile name="prod,production">
    <root level="${LOG_LEVEL_ROOT:-INFO}">
      <appender-ref ref="CONSOLE_JSON"/>
    </root>
  </springProfile>

  <springProfile name="!prod &amp; !production">
    <root level="${LOG_LEVEL_ROOT:-INFO}">
      <appender-ref ref="CONSOLE_TEXT"/>
    </root>
    <logger name="com.game.backend" level="${LOG_LEVEL_APP:-DEBUG}"/>
  </springProfile>
</configuration>
